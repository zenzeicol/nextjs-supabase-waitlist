# Copy this file to .env.local and fill in the values. .env.local is gitignored.

# --- Supabase -----------------------------------------------------------------
# Local development: run `supabase start`, then `supabase status -o env` and copy
# API_URL and ANON_KEY here.
# Production: your project's API URL and anon (public) key from the Supabase
# dashboard.
#
# The anon key is PUBLIC by design: the NEXT_PUBLIC_ prefix ships it to the
# browser. What protects the data is Row Level Security (see
# supabase/migrations). NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Cloudflare Turnstile -------------------------------------------------------
# The values below are Cloudflare's PUBLIC TEST KEYS ("always passes"). They are
# documented by Cloudflare for development and are not secrets. Replace both
# with the keys of your own widget in production.
#
# Mind the prefix:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY  is public and HAS to be: Next inlines it in
#                                   the browser bundle because the widget runs there.
#   TURNSTILE_SECRET_KEY            is server-only. Without NEXT_PUBLIC_ it never
#                                   reaches the browser. Never add the prefix to it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Resend (optional) ----------------------------------------------------------
# Welcome email for new waitlist sign-ups (lib/welcome-email.ts). Server-only.
# The site works WITHOUT it: sign-ups are still saved and only the email is
# skipped (a "[email] RESEND_API_KEY is missing" line is logged).
RESEND_API_KEY=

# --- Site -----------------------------------------------------------------------
# Canonical URL used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
